{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verified site observations — no invented locations or economics",
  "type": "object",
  "required": ["schema_version", "sites"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["site_id", "candidate_id", "lat", "lng"],
        "additionalProperties": false,
        "properties": {
          "site_id": {"type": "string", "minLength": 1},
          "candidate_id": {"enum": ["OC-001", "OC-013", "OC-020", "OC-008"]},
          "name": {"type": ["string", "null"]},
          "lat": {"type": "number", "minimum": 33, "maximum": 39},
          "lng": {"type": "number", "minimum": 124, "maximum": 132},
          "address": {"type": ["string", "null"]},
          "commercial_area_id": {"type": ["string", "null"]},
          "observed_at": {"type": ["string", "null"], "format": "date-time"},
          "status": {"type": ["string", "null"]},
          "rent": {"type": ["number", "null"], "minimum": 0, "description": "Observed monthly KRW; null is unknown"},
          "deposit": {"type": ["number", "null"], "minimum": 0, "description": "Observed KRW; null is unknown"},
          "area_sqm": {"type": ["number", "null"], "exclusiveMinimum": 0},
          "host_type": {"type": ["string", "null"]},
          "revenue_share": {"type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "Host's share as fraction; null is unknown"},
          "source": {"type": ["string", "null"]},
          "field_note": {"type": ["string", "null"]},
          "photo_reference": {"type": ["string", "null"]}
        }
      }
    }
  }
}
